@{
    ViewBag.Title = "Student Registration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-bg">
    <div class="auth-card register-customer">
        <h2>STUDENT REGISTER</h2>

        <div id="messageBox" style="display:none; padding:12px; margin-bottom:20px; border-radius:10px; font-size:13px;"></div>

        <form id="registerForm" onsubmit="return registerStudent(event)">
            <input type="text" id="firstName" placeholder="First Name" required>
            <input type="text" id="lastName" placeholder="Last Name" required>
            <input type="text" id="username" placeholder="Username" required>
            <input type="email" id="email" placeholder="Email Address" required>
            <input type="password" id="password" placeholder="Password" required>
            <input type="date" id="birthdate" placeholder="Birthdate">

            <!-- Contact Number - numbers only -->
            <input type="text" id="contact" placeholder="Contact Number"
                   onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                   maxlength="11"
                   title="Please enter 11-digit number (e.g., 09123456789)">

            <input type="text" id="section" placeholder="Section (e.g., BSIT-3A)">

            <!-- Student ID - numbers and dash only -->
            <input type="text" id="studentId" placeholder="Student ID No. (e.g., 24-1574)"
                   onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || event.charCode === 45"
                   maxlength="7"
                   title="Format: 24-1574 or 23-1542">

            <div class="upload-link-wrapper">
                <span class="upload-text-link" onclick="document.getElementById('qcidFile').click()">📎 Upload QCUID</span>
                <span id="fileNameDisplay" class="file-name-display">No file chosen</span>
                <input type="file" id="qcidFile" accept="image/*,.pdf" style="display:none" onchange="updateFileName()">
            </div>

            <button type="submit" class="auth-btn">REGISTER</button>
        </form>

        <div class="auth-links">
            Already have an account? <a href="@Url.Action("Login", "Home")">Login</a><br />
            Want to Sell? <a href="@Url.Action("RegisterEnterprise", "Home")">Sign Up Here</a>
        </div>
    </div>
</div>

<script>
    function updateFileName() {
        const fileInput = document.getElementById('qcidFile');
        const fileNameDisplay = document.getElementById('fileNameDisplay');
        if (fileInput.files.length > 0) {
            fileNameDisplay.textContent = fileInput.files[0].name;
        } else {
            fileNameDisplay.textContent = 'No file chosen';
        }
    }

    function showMessage(message, type) {
        const msgBox = document.getElementById('messageBox');
        msgBox.textContent = message;
        msgBox.style.backgroundColor = type === 'error' ? '#fee' : '#e8f5e9';
        msgBox.style.color = type === 'error' ? '#c33' : '#2e7d32';
        msgBox.style.border = type === 'error' ? '1px solid #fcc' : '1px solid #c8e6c9';
        msgBox.style.display = 'block';

        setTimeout(() => {
            msgBox.style.display = 'none';
        }, 5000);
    }

    function validateStudentId(id) {
        const pattern = /^[0-9]{2}-[0-9]{4}$/;
        return pattern.test(id);
    }

    function validateContactNumber(contact) {
        const pattern = /^[0-9]{11}$/;
        return pattern.test(contact);
    }

    function registerStudent(event) {
        event.preventDefault();

        const firstName = document.getElementById('firstName').value;
        const lastName = document.getElementById('lastName').value;
        const username = document.getElementById('username').value;
        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;
        const studentId = document.getElementById('studentId').value;
        const contact = document.getElementById('contact').value;

        if (!firstName || !lastName || !username || !email || !password) {
            showMessage('Please fill in all required fields!', 'error');
            return false;
        }

        // Validate Student ID if provided
        if (studentId && !validateStudentId(studentId)) {
            showMessage('Student ID must be in format: 24-1574 or 23-1542', 'error');
            return false;
        }

        // Validate Contact Number if provided
        if (contact && !validateContactNumber(contact)) {
            showMessage('Contact Number must be 11 digits (e.g., 09123456789)', 'error');
            return false;
        }

        let users = JSON.parse(localStorage.getItem('bizzyqcu_users') || '[]');
        const userExists = users.some(u => u.username === username || u.email === email);

        if (userExists) {
            showMessage('Username or Email already exists!', 'error');
            return false;
        }

        let fileInfo = '';
        const fileInput = document.getElementById('qcidFile');
        if (fileInput.files.length > 0) {
            fileInfo = fileInput.files[0].name;
        }

        const newUser = {
            id: Date.now(),
            firstName: firstName,
            lastName: lastName,
            username: username,
            email: email,
            password: password,
            birthdate: document.getElementById('birthdate').value,
            contact: contact,
            section: document.getElementById('section').value,
            studentId: studentId,
            qcidFile: fileInfo,
            userType: 'student',
            registeredDate: new Date().toISOString()
        };

        users.push(newUser);
        localStorage.setItem('bizzyqcu_users', JSON.stringify(users));

        showMessage('Registration successful! Redirecting to login...', 'success');

        setTimeout(() => {
            window.location.href = '@Url.Action("Login", "Home")';
        }, 2000);

        return false;
    }
</script>