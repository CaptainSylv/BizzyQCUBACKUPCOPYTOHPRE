@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-bg">
    <div class="auth-card register-enterprise">
        <h2>Register (Enterprise)</h2>
        @using (Html.BeginForm("RegisterEnterprise", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <input type="text" name="EnterpriseName" placeholder="Enterprise Name" required />
            <input type="text" name="Username" placeholder="Username" required />
            <input type="password" name="Password" placeholder="Password" required />
            <input type="email" name="Email" placeholder="Email" required />

            <!-- Contact Number - Numbers Only -->
            <input type="text" name="ContactNumber" id="ContactNumber" placeholder="Contact Number" required
                   onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                   oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                   maxlength="11" />

            <!-- Type of Enterprise - Food or Product ONLY -->
            <select name="Type" id="Type" required>
                <option value="" disabled selected>-- Select Enterprise Type --</option>
                <option value="Food">Food</option>
                <option value="Product">Product</option>
            </select>

            <div class="upload-link-wrapper">
                <input type="file" name="Documents" id="docsFile" accept=".pdf,.jpg,.png,.doc,.docx" required style="display: none;" />
                <a href="#" class="upload-text-link" onclick="document.getElementById('docsFile').click(); return false;">Upload Document</a>
                <span class="file-name-display" id="docsFileName">No file chosen</span>
            </div>

            <button type="submit" class="auth-btn">Register</button>
        }
        <div class="auth-links">
            <a href="@Url.Action("Login","Account")">Back to Login</a><br />
            <span>Want to Buy? <a href="@Url.Action("RegisterCustomer","Account")">Sign Up Here</a></span>
        </div
    </div>
</div>

<script>
    // @@ts-nocheck
    document.getElementById('docsFile').onchange = function() {
        var span = document.getElementById('docsFileName');
        if (span && this.files && this.files[0]) {
            span.innerText = this.files[0].name;
        } else if (span) {
            span.innerText = 'No file chosen';
        }
    };
</script>